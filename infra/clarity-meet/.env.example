# Ключи LiveKit для Clarity Meet.
#
# Сгенерировать:
#   docker run --rm livekit/livekit-server:v1.13.6 generate-keys
#
# Одна и та же пара обязана стоять в трёх местах: здесь (её читает SFU через
# compose), в конфигурации egress и в приложении. Рассинхрон даёт молчаливый
# отказ авторизации — без внятной ошибки в логе, просто «unauthorized».
#
# Файл на сервере лежит в /opt/clarity-meet/.env с правами 600 и в git
# не попадает. Ключи из репозиториев и примеров использовать нельзя: они
# публичны по определению.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Пароль Redis. Redis обязателен: SFU без него живёт, а egress падает
# с segfault — он использует его как транспорт psrpc.
# Сгенерировать: openssl rand -hex 24
REDIS_PASSWORD=
