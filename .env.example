ANTHROPIC_API_KEY=
VAULT_PATH=./vault
DATABASE_PATH=./data/pis.db
PORT=3001
NODE_ENV=development
OPENAI_API_KEY=
# LLM. Пусто — AI-функции выключены, API отвечает 501, сервис работает.
# Для размещения обработки в РФ достаточно сменить эти две переменные:
#   OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
OPENAI_BASE_URL=
MAX_FILE_SIZE_MB=50
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# 152-ФЗ: разрешить ли откат расшифровки аудио на облачный OpenAI whisper-1, если
# локальные бэкенды (faster-whisper / whisper.cpp) недоступны. Сырая запись голоса —
# самые чувствительные персданные, отправка в OpenAI — трансграничная передача в США.
# По умолчанию (не задано) фолбэк разрешён — текущее поведение прода не меняется.
# Поставьте false, чтобы запретить: при отказе локального бэкенда будет честная ошибка
# вместо тихой отправки записи наружу.
TRANSCRIPTION_ALLOW_CLOUD_FALLBACK=
