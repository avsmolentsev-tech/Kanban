# Clarity Meet — сервис комнат, токенов и расшифровки.
#
# Файл на сервере лежит в /opt/clarity-meet/meet-api/.env с правами 600.
# Сервис отказывается стартовать без ключей LiveKit и без пароля сервиса —
# лучше не работать, чем работать нараспашку.

# Пара ключей LiveKit. Та же, что в /opt/clarity-meet/.env: рассинхрон даёт
# молчаливый отказ авторизации без внятной ошибки в логе.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Пароль сервиса: кому вообще можно заводить встречи на этом сервере.
# К паролю конкретной встречи отношения не имеет — тот задаёт создатель.
MEET_PASSWORD=

# Порт. Наружу не публикуется, снаружи его проксирует nginx.
PORT=7890

# Сколько живёт токен входа в комнату.
MEET_TOKEN_HOURS=6

# Куда egress складывает записи.
MEET_RECORDINGS_DIR=/opt/clarity-meet/recordings

# Сервис расшифровки. Свой экземпляр, а не общий: общий держит два потока
# и делится с восемью чужими продуктами.
TRANSCRIBE_SERVICE_URL=http://127.0.0.1:8091
MEET_TRANSCRIBE_LANG=ru

# Clarity Space: куда уезжает стенограмма. Токен выпускается в кабинете
# Clarity Space и там же отзывается. Пусто — интеграция выключена, встреча
# остаётся только в Meet.
CLARITY_API_URL=https://clarity-space.ru
CLARITY_API_TOKEN=
